<div style="font-family:Arial,sans-serif;max-width:900px;margin:auto;color:#17233c">

<h1 style="text-align:center">🛒 DardomaMOGS Cart</h1>

<div id="products" style="display:flex;flex-wrap:wrap;gap:15px;justify-content:center"></div>

<hr style="margin:30px 0">

<h2>🛒 Your Cart</h2>
<div id="cart"></div>

<div id="summary" style="margin-top:20px"></div>

<button onclick="placeOrder()" style="padding:12px 20px;border:0;border-radius:10px;background:#17233c;color:white;font-weight:bold;cursor:pointer">
Place Order
</button>

<div id="order" style="margin-top:20px"></div>

<script>
const DELIVERY_FEE = 20;

const products = [
  {name:"Karkade",emoji:"❤️",price:10},
  {name:"Mango",emoji:"🥭",price:10},
  {name:"Pepsi",emoji:"🥤",price:10}
];

let cart = [];

function showProducts(){
  document.getElementById("products").innerHTML = products.map((p,i)=>`
    <div style="background:white;border:1px solid #ddd;border-radius:15px;padding:20px;text-align:center;width:200px">
      <div style="font-size:50px">${p.emoji}</div>
      <h2>${p.name}</h2>
      <p><b>${p.price} EGP</b></p>
      <button onclick="add(${i})"
        style="padding:10px 15px;border:0;border-radius:8px;background:#17233c;color:white;font-weight:bold">
        Add to Cart
      </button>
    </div>
  `).join("");
}

function add(i){
  cart.push(products[i]);
  showCart();
}

function removeItem(i){
  cart.splice(i,1);
  showCart();
}

function showCart(){

  let subtotal = 0;

  if(cart.length === 0){

    document.getElementById("cart").innerHTML =
      "<p>Your cart is empty.</p>";

    document.getElementById("summary").innerHTML =
      "<h2>Total: 0 EGP</h2>";

    return;
  }

  document.getElementById("cart").innerHTML = cart.map((p,i)=>{

    subtotal += p.price;

    return `
      <div style="padding:10px;border-bottom:1px solid #ddd">
        ${p.emoji} <b>${p.name}</b> — ${p.price} EGP

        <button onclick="removeItem(${i})"
          style="margin-left:10px">
          Remove
        </button>
      </div>
    `;

  }).join("");

  const total = subtotal + DELIVERY_FEE;

  document.getElementById("summary").innerHTML = `
    <div style="padding:15px;background:#f1f5ff;border-radius:15px">

      <p><b>Subtotal:</b> ${subtotal} EGP</p>

      <p><b>🚚 Delivery:</b> ${DELIVERY_FEE} EGP</p>

      <hr>

      <h2>💰 Total: ${total} EGP</h2>

    </div>
  `;
}

function placeOrder(){

  if(cart.length === 0){
    alert("Your cart is empty!");
    return;
  }

  let items = cart.map(p => p.name).join(", ");

  let subtotal = cart.reduce(
    (sum,p) => sum + p.price, 0
  );

  let total = subtotal + DELIVERY_FEE;

  document.getElementById("order").innerHTML = `
    <div style="padding:20px;background:#f1f5ff;border-radius:15px">

      <h2>📦 Order Details</h2>

      <label>Your name:</label><br>

      <input id="name"
        style="padding:10px;width:90%;margin:8px 0">

      <br>

      <label>Contact information:</label><br>

      <input id="contact"
        style="padding:10px;width:90%;margin:8px 0">

      <br>

      <p><b>Items:</b> ${items}</p>

      <p><b>Subtotal:</b> ${subtotal} EGP</p>

      <p><b>🚚 Delivery:</b> ${DELIVERY_FEE} EGP</p>

      <p><b>💰 Total:</b> ${total} EGP</p>

      <button onclick="finishOrder()"
        style="padding:12px 20px;border:0;border-radius:10px;background:#17233c;color:white;font-weight:bold">

        Submit Order

      </button>

    </div>
  `;
}

function finishOrder(){

  let name = document.getElementById("name").value;
  let contact = document.getElementById("contact").value;

  if(!name || !contact){

    alert("Please enter your name and contact information.");

    return;
  }

  alert(
    "Thank you, " + name +
    "! Your order has been prepared."
  );
}

showProducts();
showCart();
</script>

</div>
